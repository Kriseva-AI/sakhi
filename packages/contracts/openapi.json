        "tags": [
          "Opt-in public travel preview"
        ],
        "summary": "Cities",
        "operationId": "cities_api_explore_cities_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CityRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
