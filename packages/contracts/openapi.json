                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/explore/weather": {
      "post": {
        "tags": [
          "Opt-in public travel preview"
        ],
        "summary": "Weather",
        "operationId": "weather_api_explore_weather_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Point"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/explore/route": {
      "post": {
        "tags": [
          "Opt-in public travel preview"
        ],
        "summary": "Route",
        "operationId": "route_api_explore_route_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RouteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/navigate": {
      "post": {
        "summary": "Navigate Http",
        "operationId": "navigate_http_api_navigate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NavigateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NavigateResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/maintenance": {
      "get": {
        "summary": "Maintenance Summary",
        "operationId": "maintenance_summary_api_maintenance_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CityRequest": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 40,
            "minLength": 2,
            "title": "Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ],
        "title": "CityRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "NavigateRequest": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 2000,
            "title": "Text",
            "default": ""
          },
          "locale": {
            "type": "string",
            "enum": [
              "as-IN",
              "bn-IN",
              "brx-IN",
              "doi-IN",
              "gu-IN",
              "hi-IN",
              "kn-IN",
              "ks-Arab-IN",
              "kok-IN",
              "mai-IN",
              "ml-IN",
              "mni-Mtei-IN",
              "mr-IN",
              "ne-IN",
              "or-IN",
              "pa-IN",
              "sa-IN",
              "sat-Olck-IN",
              "sd-Arab-IN",
              "ta-IN",
              "te-IN",
              "ur-IN",
              "en-IN"
            ],
            "title": "Locale",
            "default": "en-IN"
          },
          "category": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "cyber",
                  "home",
                  "workplace",
                  "legal",
                  "friend",
                  "unsure"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Category"
          },
          "urgency": {
            "type": "boolean",
            "title": "Urgency",
            "default": false
          },
          "under18": {
            "type": "boolean",
            "title": "Under18",
            "default": false
          },
          "jurisdiction": {
            "type": "string",
            "enum": [
              "India",
              "West Bengal",
              "Other state or UT"
            ],
            "title": "Jurisdiction",
            "default": "India"
          },
          "goal": {
            "type": "string",
            "enum": [
              "understand",
              "report",
              "support",
              "friend"
            ],
            "title": "Goal",
            "default": "understand"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "NavigateRequest"
      },
      "NavigateResponse": {
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "urgent_redirect",
              "minor_redirect",
              "present_options"
            ],
            "title": "State"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "abstained": {
            "type": "boolean",
            "title": "Abstained"
          },
          "resources": {
            "items": {
              "$ref": "#/components/schemas/Resource"
            },
            "type": "array",
            "title": "Resources"
          },
          "engine": {
            "type": "string",
            "title": "Engine"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "language_status": {
            "type": "string",
            "const": "review_pending",
            "title": "Language Status",
            "default": "review_pending"
          },
          "content_locale": {
            "type": "string",
            "title": "Content Locale",
            "default": "en-IN"
          },
          "external_actions": {
            "type": "boolean",
            "title": "External Actions",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "state",
          "category",
          "abstained",
          "resources",
          "engine",
          "warnings"
        ],
        "title": "NavigateResponse"
      },
      "PlaceRequest": {
        "properties": {
          "lat": {
            "type": "number",
            "maximum": 37.5,
            "minimum": 6.0,
            "title": "Lat"
          },
          "lon": {
            "type": "number",
            "maximum": 98.0,
            "minimum": 68.0,
            "title": "Lon"
          },
          "kind": {
            "type": "string",
            "enum": [
              "police",
              "hospital",
              "pharmacy",
              "transport"
            ],
            "title": "Kind"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "lat",
          "lon",
          "kind"
        ],
        "title": "PlaceRequest"
      },
      "Point": {
        "properties": {
          "lat": {
            "type": "number",
            "maximum": 37.5,
            "minimum": 6.0,
            "title": "Lat"
          },
          "lon": {
            "type": "number",
            "maximum": 98.0,
            "minimum": 68.0,
            "title": "Lon"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "lat",
          "lon"
        ],
        "title": "Point"
      },
      "Resource": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "source_url": {
            "type": "string",
            "title": "Source Url"
          },
          "authority": {
            "type": "string",
            "title": "Authority"
          },
          "phone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone"
          },
          "categories": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Categories"
          },
          "jurisdiction": {
            "type": "string",
            "title": "Jurisdiction"
          },
          "eligibility": {
            "type": "string",
            "title": "Eligibility"
          },
          "checked_at": {
            "type": "string",
            "title": "Checked At"
          },
          "expires_at": {
            "type": "string",
            "title": "Expires At"
          },
          "verification_method": {
            "type": "string",
            "title": "Verification Method"
          },
          "review_status": {
            "type": "string",
            "title": "Review Status"
          },
          "access_type": {
            "type": "string",
            "title": "Access Type"
          },
          "service_cost": {
            "type": "string",
            "title": "Service Cost"
          },
          "permission": {
            "type": "string",
            "title": "Permission"
          },
          "limitations": {
            "type": "string",
            "title": "Limitations"
          },
          "status": {
            "type": "string",
            "const": "verified_public_link",
            "title": "Status",
            "default": "verified_public_link"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "summary",
          "url",
          "source_url",
          "authority",
          "categories",
          "jurisdiction",
          "eligibility",
          "checked_at",
          "expires_at",
          "verification_method",
          "review_status",
          "access_type",
          "service_cost",
          "permission",
          "limitations"
        ],
        "title": "Resource"
      },
      "RouteRequest": {
        "properties": {
          "start": {
            "$ref": "#/components/schemas/Point"
          },
          "end": {
            "$ref": "#/components/schemas/Point"
          },
          "mode": {
            "type": "string",
            "enum": [
              "foot",
              "car"
            ],
            "title": "Mode"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "start",
          "end",
          "mode"
        ],
        "title": "RouteRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
