{
  "openapi": "3.1.0",
  "info": {
    "title": "Kriseva Sakhi public navigator",
    "description": "Local preview. No private storage, submissions or provider integrations.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/navigate": {
      "post": {
        "summary": "Navigate",
        "operationId": "navigate_api_navigate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NavigateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NavigateResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/maintenance": {
      "get": {
        "summary": "Maintenance Summary",
        "operationId": "maintenance_summary_api_maintenance_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "NavigateRequest": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 2000,
            "title": "Text",
            "default": ""
          },
          "locale": {
            "type": "string",
            "enum": [
              "en-IN",
              "hi-IN",
              "bn-IN",
              "mr-IN",
              "te-IN",
              "ta-IN",
              "gu-IN",
              "kn-IN",
              "ml-IN",
              "or-IN",
              "pa-IN",
              "as-IN",
              "ur-IN",
              "ne-IN",
              "kok-IN",
              "ks-Arab-IN"
            ],
            "title": "Locale",
            "default": "en-IN"
          },
          "category": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "cyber",
                  "home",
                  "workplace",
                  "legal",
                  "friend",
                  "unsure"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Category"
          },
          "urgency": {
            "type": "boolean",
            "title": "Urgency",
            "default": false
          },
          "under18": {
            "type": "boolean",
            "title": "Under18",
            "default": false
          },
          "jurisdiction": {
            "type": "string",
            "enum": [
              "India",
              "West Bengal",
              "Other state or UT"
            ],
            "title": "Jurisdiction",
            "default": "India"
          },
          "goal": {
            "type": "string",
            "enum": [
              "understand",
              "report",
              "support",
              "friend"
            ],
            "title": "Goal",
            "default": "understand"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "NavigateRequest"
      },
      "NavigateResponse": {
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "urgent_redirect",
              "minor_redirect",
              "present_options"
            ],
            "title": "State"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "abstained": {
            "type": "boolean",
            "title": "Abstained"
          },
          "resources": {
            "items": {
              "$ref": "#/components/schemas/Resource"
            },
            "type": "array",
            "title": "Resources"
          },
          "engine": {
            "type": "string",
            "title": "Engine"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "language_status": {
            "type": "string",
            "const": "review_pending",
            "title": "Language Status",
            "default": "review_pending"
          },
          "content_locale": {
            "type": "string",
            "title": "Content Locale",
            "default": "en-IN"
          },
          "external_actions": {
            "type": "boolean",
            "title": "External Actions",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "state",
          "category",
          "abstained",
          "resources",
          "engine",
          "warnings"
        ],
        "title": "NavigateResponse"
      },
      "Resource": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "source_url": {
            "type": "string",
            "title": "Source Url"
          },
          "authority": {
            "type": "string",
            "title": "Authority"
          },
          "phone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone"
          },
          "categories": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Categories"
          },
          "jurisdiction": {
            "type": "string",
            "title": "Jurisdiction"
          },
          "eligibility": {
            "type": "string",
            "title": "Eligibility"
          },
          "checked_at": {
            "type": "string",
            "title": "Checked At"
          },
          "expires_at": {
            "type": "string",
            "title": "Expires At"
          },
          "verification_method": {
            "type": "string",
            "title": "Verification Method"
          },
          "review_status": {
            "type": "string",
            "title": "Review Status"
          },
          "access_type": {
            "type": "string",
            "title": "Access Type"
          },
          "service_cost": {
            "type": "string",
            "title": "Service Cost"
          },
          "permission": {
            "type": "string",
            "title": "Permission"
          },
          "limitations": {
            "type": "string",
            "title": "Limitations"
          },
          "status": {
            "type": "string",
            "const": "verified_public_link",
            "title": "Status",
            "default": "verified_public_link"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "summary",
          "url",
          "source_url",
          "authority",
          "categories",
          "jurisdiction",
          "eligibility",
          "checked_at",
          "expires_at",
          "verification_method",
          "review_status",
          "access_type",
          "service_cost",
          "permission",
          "limitations"
        ],
        "title": "Resource"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
